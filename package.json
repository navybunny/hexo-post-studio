  "repository": {
    "type": "git",
    "url": "git+https://github.com/navybunny/hexo-post-studio.git"
  },
  "bugs": {
    "url": "https://github.com/navybunny/hexo-post-studio/issues"
  },
  "homepage": "https://github.com/navybunny/hexo-post-studio#readme",
  "dependencies": {
    "express": "^5.3.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.2",
    "sharp": "^0.33.5"
