  "description": "本地运行的 Hexo 图文发布工作台：Markdown 编辑、图片自动压缩、一键发布",
  "license": "MIT",
  "author": "NavyBunny",
  "main": "server/index.js",
  "bin": {
    "hexo-post-studio": "bin/cli.js"
  },
  "files": [
    "bin/",
    "server/",
    "public/",
    "README.md",
    "LICENSE",
    "docs/screenshot.png"
  ],
